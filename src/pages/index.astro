---
import '../styles/global.css';

const site = Astro.site;
const canonicalUrl = site ? new URL(Astro.url.pathname, site).toString() : undefined;
const ogImage = site ? new URL('/images/kuah-waterfront.webp', site).toString() : '/images/kuah-waterfront.webp';

const nearbyFood = [
  {
    name: 'Restoran Nur Hafizah',
    type: 'Nasi campur Melayu',
    note: 'Pilihan lauk tempatan yang mudah untuk makan tengah hari selepas tiba di Kuah.',
    query: 'Restoran Nur Hafizah Kuah Langkawi',
  },
  {
    name: 'As Nasi Campur',
    type: 'Hidangan tempatan',
    note: 'Singgahan santai di kawasan waterfront untuk nasi campur dan lauk harian.',
    query: 'As Nasi Campur Baron Waterfront Kuah Langkawi',
  },
  {
    name: 'Idamanriah Cafe Roti Canai',
    type: 'Sarapan & roti canai',
    note: 'Sesuai untuk sarapan ringkas sebelum bergerak ke terminal atau sekitar bandar Kuah.',
    query: 'Idamanriah Cafe Roti Canai Kuah Langkawi',
  },
  {
    name: 'Arts Cafe Langkawi',
    type: 'Kafe',
    note: 'Pilihan kopi dan hidangan ringan di pusat Kuah apabila mahu berehat lebih lama.',
    query: 'Arts Cafe Langkawi Kuah',
  },
];

const nearbyAttractions = [
  {
    name: 'Dataran Lang',
    kicker: 'Ikon Langkawi',
    image: '/images/dataran-lang.webp',
    alt: 'Patung helang besar di Dataran Lang berhampiran Jeti Kuah',
    note: 'Mercu tanda helang gergasi di tepi laut; sangat sesuai digabungkan dengan lawatan ke jeti.',
  },
  {
    name: 'Taman Lagenda',
    kicker: 'Taman waterfront',
    image: '/images/taman-lagenda.webp',
    alt: 'Pintu masuk Taman Lagenda Langkawi di Kuah',
    note: 'Taman bertema kisah dan legenda Langkawi, berhampiran Dataran Lang dan kawasan jeti.',
  },
  {
    name: 'Masjid Al-Hana',
    kicker: 'Warisan Kuah',
    image: '/images/masjid-al-hana.webp',
    alt: 'Masjid Al-Hana di bandar Kuah Langkawi',
    note: 'Masjid utama di Kuah dengan seni bina yang mudah dikenali, sesuai sebagai persinggahan bandar.',
  },
];

const faqs = [
  {
    q: 'Adakah perlu membeli tiket untuk masuk ke Jeti Kuah?',
    a: 'Tidak untuk memasuki kawasan awam terminal. Tiket hanya diperlukan apabila anda hendak menaiki feri atau memasuki kawasan berlepas yang dikawal. Tambang bergantung pada laluan dan operator.',
  },
  {
    q: 'Berapa awal perlu tiba sebelum feri berlepas?',
    a: 'Sebagai panduan selamat, tiba sekurang-kurangnya 60 minit sebelum waktu berlepas. Beri masa tambahan pada hujung minggu, cuti umum atau jika perlu melalui pemeriksaan bagasi dan dokumen.',
  },
  {
    q: 'Ada tempat letak kereta berhampiran terminal?',
    a: 'Ya, terdapat ruang parkir di sekitar kompleks jeti dan Jetty Point. Ketersediaan, aturan dan kadar parkir boleh berubah, jadi sediakan sedikit masa tambahan ketika waktu sibuk.',
  },
  {
    q: 'Bilakah waktu terbaik untuk singgah jika bukan menaiki feri?',
    a: 'Awal pagi atau lewat petang biasanya lebih selesa untuk berjalan di kawasan waterfront dan mengambil gambar. Cahaya juga lebih lembut berbanding tengah hari.',
  },
  {
    q: 'Berapa lama patut diperuntukkan?',
    a: 'Sekitar 30–60 minit memadai untuk melihat kawasan jeti dan waterfront. Jika digabungkan dengan Dataran Lang dan Taman Lagenda, peruntukkan kira-kira 1.5–2.5 jam mengikut rentak sendiri.',
  },
  {
    q: 'Boleh dapat Grab atau teksi dari Jeti Kuah?',
    a: 'Ya. Jeti Kuah ialah hab ketibaan utama dan e-hailing serta teksi lazim digunakan untuk bergerak ke penginapan atau tarikan lain di Langkawi. Masa menunggu bergantung pada keadaan semasa.',
  },
];

const attractionSchema = {
  '@context': 'https://schema.org',
  '@type': ['TouristAttraction', 'LocalBusiness'],
  name: 'Jeti Kuah (Kuah Jetty)',
  alternateName: 'Kuah Jetty',
  description: 'Terminal feri utama di Kuah dan salah satu gerbang laut ke Pulau Langkawi, Kedah.',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Straits Court Comdominium, Kuah',
    addressLocality: 'Langkawi',
    postalCode: '07000',
    addressRegion: 'Kedah',
    addressCountry: 'MY',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: 6.3060687,
    longitude: 99.85149,
  },
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
      opens: '08:00',
      closes: '18:00',
    },
  ],
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: 4.3,
    ratingCount: 8370,
    bestRating: 5,
  },
  ...(canonicalUrl ? { url: canonicalUrl } : {}),
  ...(site ? { image: [new URL('/images/kuah-waterfront.webp', site).toString(), new URL('/images/kuah-jetty.webp', site).toString()] } : {}),
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.a,
    },
  })),
};
---
<!doctype html>
<html lang="ms">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#073b4c" />
    <meta name="description" content="Panduan bebas Jeti Kuah, Langkawi: cara ke terminal, feri, parkir, waktu terbaik, tempat makan dan tarikan berdekatan." />
    <title>Jeti Kuah Langkawi — Gerbang Laut ke Pulau Langkawi</title>

    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ms_MY" />
    <meta property="og:title" content="Jeti Kuah Langkawi — Gerbang Laut ke Pulau Langkawi" />
    <meta property="og:description" content="Panduan praktikal untuk singgah, menaiki feri dan meneroka sekitar Jeti Kuah." />
    <meta property="og:image" content={ogImage} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Jeti Kuah Langkawi" />
    <meta name="twitter:description" content="Feri, parkir, makan dan tarikan sekitar gerbang laut Kuah." />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/favicon-16.png" sizes="16x16" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />

    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-HXM22WWPKP"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-HXM22WWPKP');
    </script>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(attractionSchema)}></script>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>
  </head>
  <body>
    <a class="skip-link" href="#kandungan">Lompat ke kandungan</a>

    <header class="absolute inset-x-0 top-0 z-30">
      <div class="shell flex items-center justify-between py-5">
        <a href="#atas" aria-label="Kembali ke atas" class="inline-flex rounded-2xl bg-white/95 p-2 shadow-lg shadow-black/10 backdrop-blur">
          <img src="/logo.svg" width="210" height="52" alt="Logo Jeti Kuah — Gerbang Laut Langkawi" />
        </a>
        <nav aria-label="Navigasi utama" class="hidden items-center gap-1 rounded-full border border-white/20 bg-[#052f3c]/70 p-1 text-sm font-bold text-white backdrop-blur md:flex">
          <a class="rounded-full px-4 py-2 hover:bg-white/10" href="#panduan">Panduan</a>
          <a class="rounded-full px-4 py-2 hover:bg-white/10" href="#makan">Makan</a>
          <a class="rounded-full px-4 py-2 hover:bg-white/10" href="#sekitar">Sekitar</a>
          <a class="rounded-full px-4 py-2 hover:bg-white/10" href="#faq">FAQ</a>
        </nav>
      </div>
    </header>

    <main id="kandungan">
      <section id="atas" class="relative min-h-[760px] overflow-hidden bg-[#052f3c] text-white md:min-h-[820px]">
        <img
          src="/images/kuah-waterfront.webp"
          alt="Pemandangan waterfront Kuah dengan jeti dan laut Langkawi"
          class="absolute inset-0 h-full w-full object-cover object-center"
          width="1280"
          height="850"
          fetchpriority="high"
        />
        <div class="hero-mask port-grid absolute inset-0"></div>
        <div class="absolute -bottom-32 -right-20 h-96 w-96 rounded-full border border-white/15"></div>
        <div class="absolute -bottom-16 -right-4 h-64 w-64 rounded-full border border-white/20"></div>

        <div class="shell relative z-10 flex min-h-[760px] items-end pb-16 pt-36 md:min-h-[820px] md:pb-24">
          <div class="w-full">
            <div class="eyebrow text-[#f1b16f]">Gerbang laut Langkawi</div>
            <h1 class="mt-5 max-w-4xl text-[clamp(4.4rem,13vw,10rem)] font-black leading-[0.78] tracking-[-0.07em]">
              Jeti<br /><span class="text-[#f1b16f]">Kuah.</span>
            </h1>
            <div class="mt-8 grid gap-6 border-t border-white/25 pt-7 md:grid-cols-[1.45fr_1fr] md:items-end">
              <p class="max-w-2xl text-lg leading-8 text-white/82 md:text-xl">
                Tempat feri, bandar dan ikon Langkawi bertemu — titik mula yang praktikal untuk tiba, berlepas atau menikmati waterfront Kuah sebelum meneruskan perjalanan.
              </p>
              <div class="flex flex-wrap gap-3 md:justify-end">
                <a href="#peta" class="rounded-full bg-[#d88a45] px-5 py-3 text-sm font-black text-white shadow-lg shadow-black/15 transition hover:-translate-y-0.5 hover:bg-[#c77736]">Lihat peta</a>
                <a href="https://maps.app.goo.gl/3TuZgLJLMEKkpxg3A" target="_blank" rel="noopener noreferrer" class="rounded-full border border-white/35 bg-white/10 px-5 py-3 text-sm font-black text-white backdrop-blur transition hover:bg-white/18">Buka Google Maps ↗</a>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section aria-label="Maklumat ringkas Jeti Kuah" class="relative z-20 -mt-7">
        <div class="shell grid overflow-hidden rounded-[1.75rem] border border-[#073b4c]/10 bg-[#fffdf8] shadow-2xl shadow-[#073b4c]/10 md:grid-cols-4">
          <div class="border-b border-[#073b4c]/10 p-6 md:border-b-0 md:border-r">
            <div class="text-xs font-black uppercase tracking-[.16em] text-[#7a8587]">Penilaian rujukan</div>
            <div class="mt-2 text-3xl font-black text-[#073b4c]">4.3<span class="text-base text-[#d88a45]"> / 5</span></div>
            <p class="mt-1 text-sm text-[#6c7779]">Google Maps · boleh berubah</p>
          </div>
          <div class="border-b border-[#073b4c]/10 p-6 md:border-b-0 md:border-r">
            <div class="text-xs font-black uppercase tracking-[.16em] text-[#7a8587]">Waktu rujukan</div>
            <div class="mt-2 text-3xl font-black text-[#073b4c]">08:00–18:00</div>
            <p class="mt-1 text-sm text-[#6c7779]">Setiap hari · semak jadual feri</p>
          </div>
          <div class="border-b border-[#073b4c]/10 p-6 md:border-b-0 md:border-r">
            <div class="text-xs font-black uppercase tracking-[.16em] text-[#7a8587]">Masuk kawasan awam</div>
            <div class="mt-2 text-3xl font-black text-[#073b4c]">Percuma</div>
            <p class="mt-1 text-sm text-[#6c7779]">Tiket diperlukan untuk perjalanan feri</p>
          </div>
          <div class="p-6">
            <div class="text-xs font-black uppercase tracking-[.16em] text-[#7a8587]">Lokasi</div>
            <div class="mt-2 text-xl font-black leading-tight text-[#073b4c]">Kuah, Langkawi</div>
            <p class="mt-2 text-sm leading-5 text-[#6c7779]">07000 Langkawi, Kedah, Malaysia</p>
          </div>
        </div>
      </section>

      <section class="shell py-24 md:py-32" id="panduan">
        <div class="grid gap-12 md:grid-cols-[0.82fr_1.18fr] md:items-start">
          <div class="md:sticky md:top-8">
            <div class="eyebrow text-[#b76531]">Bukan sekadar terminal</div>
            <h2 class="section-title text-[#073b4c]">Singgah dengan rancangan yang lebih jelas.</h2>
            <p class="section-copy">
              Jeti Kuah ialah hab feri utama di bandar Kuah. Ia paling berguna apabila anda tahu bila hendak tiba, di mana mahu berehat dan apa yang boleh dibuat sebelum atau selepas perjalanan laut.
            </p>
          </div>
          <div class="grid gap-4 sm:grid-cols-2">
            <article class="card p-7 sm:col-span-2 md:p-9">
              <div class="flex items-start justify-between gap-6">
                <div>
                  <div class="text-sm font-black uppercase tracking-[.16em] text-[#b76531]">Jika menaiki feri</div>
                  <h3 class="mt-3 text-3xl font-black tracking-tight text-[#073b4c]">Tiba sekurang-kurangnya 60 minit awal.</h3>
                  <p class="mt-4 max-w-2xl leading-7 text-[#657174]">Berikan ruang untuk daftar masuk, pemeriksaan, mencari pintu berlepas dan pergerakan penumpang. Pada hujung minggu atau cuti, datang lebih awal ialah pilihan lebih selesa.</p>
                </div>
                <div class="hidden h-16 w-16 shrink-0 place-items-center rounded-2xl bg-[#073b4c] text-2xl font-black text-white sm:grid">60</div>
              </div>
            </article>
            <article class="card p-7">
              <div class="text-sm font-black uppercase tracking-[.16em] text-[#0b6671]">Waktu terbaik</div>
              <h3 class="mt-3 text-2xl font-black text-[#073b4c]">Pagi awal atau lewat petang</h3>
              <p class="mt-3 leading-7 text-[#657174]">Lebih nyaman untuk berjalan di waterfront dan lebih mesra kamera berbanding cahaya tengah hari.</p>
            </article>
            <article class="card p-7">
              <div class="text-sm font-black uppercase tracking-[.16em] text-[#0b6671]">Tempoh lawatan</div>
              <h3 class="mt-3 text-2xl font-black text-[#073b4c]">30–60 minit</h3>
              <p class="mt-3 leading-7 text-[#657174]">Untuk jeti sahaja. Tambah masa jika mahu berjalan ke Dataran Lang atau Taman Lagenda.</p>
            </article>
            <article class="card p-7">
              <div class="text-sm font-black uppercase tracking-[.16em] text-[#0b6671]">Tiket & kos</div>
              <h3 class="mt-3 text-2xl font-black text-[#073b4c]">Tiada tiket tarikan</h3>
              <p class="mt-3 leading-7 text-[#657174]">Kawasan awam jeti boleh dimasuki tanpa tiket tarikan. Tambang feri berbeza mengikut laluan dan operator; semak harga semasa sebelum berangkat.</p>
            </article>
            <article class="card p-7">
              <div class="text-sm font-black uppercase tracking-[.16em] text-[#0b6671]">Parkir</div>
              <h3 class="mt-3 text-2xl font-black text-[#073b4c]">Sekitar terminal & Jetty Point</h3>
              <p class="mt-3 leading-7 text-[#657174]">Ruang parkir tersedia di sekitar kompleks. Kadar, akses dan kekosongan boleh berubah — elakkan tiba terlalu hampir dengan waktu feri.</p>
            </article>
          </div>
        </div>
      </section>

      <section class="bg-[#073b4c] py-20 text-white md:py-28">
        <div class="shell grid gap-8 lg:grid-cols-[1.05fr_.95fr] lg:items-center">
          <div class="photo-card relative overflow-hidden rounded-[2rem] bg-[#042a36]">
            <img src="/images/kuah-jetty.webp" alt="Bangunan terminal Jeti Kuah Langkawi" class="aspect-[4/3] h-full w-full object-cover" width="1280" height="960" loading="lazy" />
            <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/70 to-transparent p-7 pt-24">
              <span class="rounded-full bg-white/15 px-3 py-1 text-xs font-bold backdrop-blur">Terminal feri Kuah</span>
            </div>
          </div>
          <div class="lg:pl-8">
            <div class="eyebrow text-[#f1b16f]">Cara ke sini</div>
            <h2 class="section-title text-white">Satu jeti, beberapa cara tiba.</h2>
            <div class="mt-10 space-y-8">
              <div class="route-line grid grid-cols-[24px_1fr] gap-4">
                <div class="mt-1 h-6 w-6 rounded-full border-4 border-[#d88a45] bg-[#073b4c]"></div>
                <div><h3 class="text-xl font-black">Dari tanah besar dengan feri</h3><p class="mt-2 leading-7 text-white/70">Perkhidmatan feri penumpang menghubungkan Langkawi dengan Kuala Perlis dan Kuala Kedah. Jadual berubah mengikut operator dan keadaan operasi, jadi semak perjalanan semasa sebelum bergerak.</p></div>
              </div>
              <div class="route-line grid grid-cols-[24px_1fr] gap-4">
                <div class="mt-1 h-6 w-6 rounded-full border-4 border-[#d88a45] bg-[#073b4c]"></div>
                <div><h3 class="text-xl font-black">Dari Lapangan Terbang Langkawi</h3><p class="mt-2 leading-7 text-white/70">Gunakan kereta sewa, e-hailing atau teksi menuju bandar Kuah dan ikut papan tanda ke terminal feri / Jetty Point. Beri masa tambahan pada waktu trafik lebih padat.</p></div>
              </div>
              <div class="route-line grid grid-cols-[24px_1fr] gap-4">
                <div class="mt-1 h-6 w-6 rounded-full border-4 border-[#d88a45] bg-[#073b4c]"></div>
                <div><h3 class="text-xl font-black">Dari kawasan lain di pulau</h3><p class="mt-2 leading-7 text-white/70">E-hailing dan teksi paling mudah jika tidak memandu. Jika membawa kereta, sasarkan kawasan Jetty Point / Jeti Kuah dan ikut susun atur parkir di lokasi.</p></div>
              </div>
            </div>
            <a href="https://www.langkawiferryline.com/" target="_blank" rel="noopener noreferrer" class="mt-10 inline-flex items-center gap-2 rounded-full bg-[#d88a45] px-5 py-3 text-sm font-black transition hover:bg-[#c77736]">Semak operator feri ↗</a>
          </div>
        </div>
      </section>

      <section id="peta" class="shell py-24 md:py-32">
        <div class="grid gap-10 lg:grid-cols-[.72fr_1.28fr] lg:items-end">
          <div>
            <div class="eyebrow text-[#b76531]">Peta & orientasi</div>
            <h2 class="section-title text-[#073b4c]">Di hujung selatan bandar Kuah.</h2>
            <p class="section-copy">Jeti terletak bersebelahan kawasan waterfront, Jetty Point dan mercu tanda Dataran Lang — mudah dijadikan satu kelompok persinggahan.</p>
            <address class="mt-7 not-italic text-sm font-bold leading-6 text-[#073b4c]">Straits Court Condominium, Kuah<br />07000 Langkawi, Kedah, Malaysia</address>
          </div>
          <div class="map-frame overflow-hidden rounded-[2rem] border border-[#073b4c]/10 bg-white shadow-xl shadow-[#073b4c]/10">
            <iframe
              title="Peta Jeti Kuah, Langkawi"
              src="https://www.google.com/maps?q=6.3060687,99.85149&hl=ms&z=16&output=embed"
              loading="lazy"
              allowfullscreen
              referrerpolicy="no-referrer-when-downgrade"
            ></iframe>
          </div>
        </div>
      </section>

      <section id="makan" class="border-y border-[#073b4c]/10 bg-white/65 py-24 md:py-28">
        <div class="shell">
          <div class="eyebrow text-[#b76531]">Makan di sekitar Kuah</div>
          <h2 class="section-title text-[#073b4c]">Selepas feri, cari rasa tempatan.</h2>
          <p class="section-copy">Pilihan di bawah berada di sekitar bandar Kuah dan sesuai dijadikan rujukan sebelum atau selepas perjalanan. Waktu operasi boleh berubah.</p>
          <div class="mt-10 grid gap-4 md:grid-cols-2 lg:grid-cols-4">
            {nearbyFood.map((place, index) => (
              <a href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(place.query)}`} target="_blank" rel="noopener noreferrer" class="group card flex min-h-64 flex-col p-6 transition hover:-translate-y-1 hover:border-[#d88a45]/50">
                <div class="flex items-center justify-between"><span class="text-xs font-black tracking-[.18em] text-[#b76531]">0{index + 1}</span><span class="text-[#b76531] transition group-hover:translate-x-1">↗</span></div>
                <div class="mt-auto pt-10"><div class="text-xs font-black uppercase tracking-[.15em] text-[#7a8587]">{place.type}</div><h3 class="mt-2 text-xl font-black text-[#073b4c]">{place.name}</h3><p class="mt-3 text-sm leading-6 text-[#657174]">{place.note}</p></div>
              </a>
            ))}
          </div>
        </div>
      </section>

      <section id="sekitar" class="shell py-24 md:py-32">
        <div class="grid gap-8 lg:grid-cols-[.72fr_1.28fr] lg:items-end">
          <div>
            <div class="eyebrow text-[#b76531]">Tarikan berdekatan</div>
            <h2 class="section-title text-[#073b4c]">Jangan terus beredar dari waterfront.</h2>
          </div>
          <p class="section-copy lg:ml-auto">Jika jadual anda longgar, kawasan Kuah menawarkan beberapa persinggahan yang mudah digabungkan tanpa perlu menjelajah jauh ke bahagian lain pulau.</p>
        </div>
        <div class="mt-12 grid gap-5 lg:grid-cols-3">
          {nearbyAttractions.map((place) => (
            <article class="photo-card group overflow-hidden rounded-[1.8rem] bg-[#073b4c] text-white shadow-xl shadow-[#073b4c]/10">
              <div class="overflow-hidden"><img src={place.image} alt={place.alt} class="aspect-[4/3] w-full object-cover" loading="lazy" width="1280" height="960" /></div>
              <div class="p-7"><div class="text-xs font-black uppercase tracking-[.17em] text-[#f1b16f]">{place.kicker}</div><h3 class="mt-2 text-2xl font-black">{place.name}</h3><p class="mt-3 leading-7 text-white/70">{place.note}</p></div>
            </article>
          ))}
        </div>
        <div class="mt-5 rounded-[1.8rem] border border-[#073b4c]/10 bg-[#073b4c] p-7 text-white md:flex md:items-center md:justify-between md:gap-6">
          <div><div class="text-xs font-black uppercase tracking-[.17em] text-[#f1b16f]">Satu lagi pilihan</div><h3 class="mt-2 text-2xl font-black">MAHA Tower, Kuah</h3><p class="mt-2 max-w-2xl text-sm leading-6 text-white/70">Mercu tanda moden di bandar Kuah yang boleh dimasukkan dalam laluan bandar jika anda mempunyai lebih banyak masa.</p></div>
          <a href="https://www.google.com/maps/search/?api=1&query=MAHA+Tower+Kuah+Langkawi" target="_blank" rel="noopener noreferrer" class="mt-5 inline-flex rounded-full border border-white/25 px-5 py-3 text-sm font-black hover:bg-white/10 md:mt-0">Lihat lokasi ↗</a>
        </div>
      </section>

      <section id="faq" class="bg-[#efe3d0] py-24 md:py-28">
        <div class="shell grid gap-12 lg:grid-cols-[.72fr_1.28fr]">
          <div>
            <div class="eyebrow text-[#b76531]">Soalan lazim</div>
            <h2 class="section-title text-[#073b4c]">Perkara kecil yang elok tahu sebelum tiba.</h2>
          </div>
          <div class="divide-y divide-[#073b4c]/15 border-y border-[#073b4c]/15">
            {faqs.map((item, index) => (
              <details class="faq-item group py-2">
                <summary class="flex cursor-pointer list-none items-center justify-between gap-5 py-5 text-left text-lg font-black text-[#073b4c] marker:hidden">
                  <span><span class="mr-3 text-xs tracking-[.16em] text-[#b76531]">0{index + 1}</span>{item.q}</span>
                  <svg class="h-5 w-5 shrink-0 transition" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                </summary>
                <p class="pb-6 pl-0 pr-10 leading-7 text-[#59666b] md:pl-10">{item.a}</p>
              </details>
            ))}
          </div>
        </div>
      </section>

      <section class="shell py-20">
        <div class="grid gap-8 rounded-[2rem] border border-[#073b4c]/10 bg-white p-7 md:grid-cols-[1fr_auto] md:items-center md:p-10">
          <div>
            <div class="text-xs font-black uppercase tracking-[.17em] text-[#b76531]">Rujukan perjalanan</div>
            <h2 class="mt-2 text-2xl font-black text-[#073b4c]">Semak maklumat operasi sebelum hari perjalanan.</h2>
            <p class="mt-3 max-w-3xl leading-7 text-[#657174]">Jadual feri, tambang, kaunter, parkir dan waktu terminal boleh berubah. Gunakan laman operator feri dan Google Maps sebagai semakan semasa.</p>
          </div>
          <a href="https://www.langkawiferryline.com/" target="_blank" rel="noopener noreferrer" class="inline-flex w-fit rounded-full bg-[#073b4c] px-5 py-3 text-sm font-black text-white hover:bg-[#0b6671]">Laman feri ↗</a>
        </div>
      </section>
    </main>

    <footer class="bg-[#042a36] py-12 text-white">
      <div class="shell grid gap-8 md:grid-cols-[1fr_1.4fr] md:items-end">
        <div>
          <img src="/logo.svg" width="210" height="52" alt="Jeti Kuah" class="rounded-xl bg-white p-1.5" />
          <p class="mt-5 max-w-md text-sm leading-6 text-white/60">Laman ini ialah panduan bebas dan bukan laman rasmi Jeti Kuah, mana-mana pengendali feri atau LADA.</p>
        </div>
        <div class="text-xs leading-6 text-white/50 md:text-right">
          <p><strong class="text-white/70">Kredit foto tempatan:</strong> Marufish (CC BY-SA 2.0), Zamwan (CC BY-SA 4.0), Bernard Spragg NZ (CC0), Hzh (CC BY-SA 4.0), Olga Oslina (CC BY 2.0) melalui Wikimedia Commons.</p>
          <p class="mt-2">Maklumat penilaian dan waktu rujukan berasal daripada paparan Google Maps dan boleh berubah.</p>
        </div>
      </div>
    </footer>
  </body>
</html>

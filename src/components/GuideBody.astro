---
import { copy, localeMeta, mapsPlaceUrl, mapsEmbedUrl, mapsLink, ferryOperatorUrl, type Locale } from '../data/content';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = copy[locale];
const meta = localeMeta[locale];
const mapsUrl = mapsEmbedUrl(meta.mapHl);
const extraQuery = mapsPlaceUrl(t.nearby.extra.query);
const foodPlaces = t.food.places.map((place) => ({ ...place, url: mapsPlaceUrl(place.query) }));
---

<section id="atas" class="relative min-h-[760px] overflow-hidden bg-[#052f3c] text-white md:min-h-[820px]">
  <img
    src="/images/kuah-waterfront.webp"
    alt={t.hero.imageAlt}
    class="absolute inset-0 h-full w-full object-cover object-center"
    width="1280"
    height="850"
    fetchpriority="high"
  />
  <div class="hero-mask port-grid absolute inset-0"></div>
  <div class="absolute -bottom-32 -right-20 h-96 w-96 rounded-full border border-white/15"></div>
  <div class="absolute -bottom-16 -right-4 h-64 w-64 rounded-full border border-white/20"></div>

  <div class="shell relative z-10 flex min-h-[760px] items-end pb-16 pt-36 md:min-h-[820px] md:pb-24">
    <div class="w-full">
      <div class="eyebrow text-[#f1b16f]">{t.hero.eyebrow}</div>
      <h1 class="mt-5 max-w-4xl text-[clamp(4.4rem,13vw,10rem)] font-black leading-[0.78] tracking-[-0.07em]">
        {t.hero.h1a}<br /><span class="text-[#f1b16f]">{t.hero.h1b}</span>
      </h1>
      <div class="mt-8 grid gap-6 border-t border-white/25 pt-7 md:grid-cols-[1.45fr_1fr] md:items-end">
        <p class="max-w-2xl text-lg leading-8 text-white/82 md:text-xl">
          {t.hero.lead}
        </p>
        <div class="flex flex-wrap gap-3 md:justify-end">
          <a href="#peta" class="rounded-full bg-[#d88a45] px-5 py-3 text-sm font-black text-white shadow-lg shadow-black/15 transition hover:-translate-y-0.5 hover:bg-[#c77736]">{t.hero.ctaPrimary}</a>
          <a href={mapsLink} target="_blank" rel="noopener noreferrer" class="rounded-full border border-white/35 bg-white/10 px-5 py-3 text-sm font-black text-white backdrop-blur transition hover:bg-white/18">{t.hero.ctaSecondary}</a>
        </div>
      </div>
    </div>
  </div>
</section>

<section aria-label={t.stats[0].label} class="relative z-20 -mt-7">
  <div class="shell grid overflow-hidden rounded-[1.75rem] border border-[#073b4c]/10 bg-[#fffdf8] shadow-2xl shadow-[#073b4c]/10 md:grid-cols-4">
    {t.stats.map((item, index) => (
      <div class:list={['p-6', index < 3 ? 'border-b border-[#073b4c]/10 md:border-b-0 md:border-r' : '']}>
        <div class="text-xs font-black uppercase tracking-[.16em] text-[#7a8587]">{item.label}</div>
        <div class="mt-2 text-3xl font-black text-[#073b4c]">{item.value}</div>
        <p class="mt-1 text-sm text-[#6c7779]">{item.note}</p>
      </div>
    ))}
  </div>
</section>

<section class="shell py-24 md:py-32" id="panduan">
  <div class="grid gap-12 md:grid-cols-[0.82fr_1.18fr] md:items-start">
    <div class="md:sticky md:top-8">
      <div class="eyebrow text-[#b76531]">{t.guide.eyebrow}</div>
      <h2 class="section-title text-[#073b4c]">{t.guide.title}</h2>
      <p class="section-copy">
        {t.guide.intro}
      </p>
    </div>
    <div class="grid gap-4 sm:grid-cols-2">
      <article class="card p-7 sm:col-span-2 md:p-9">
        <div class="flex items-start justify-between gap-6">
          <div>
            <div class="text-sm font-black uppercase tracking-[.16em] text-[#b76531]">{t.guide.wideCard.kicker}</div>
            <h3 class="mt-3 text-3xl font-black tracking-tight text-[#073b4c]">{t.guide.wideCard.title}</h3>
            <p class="mt-4 max-w-2xl leading-7 text-[#657174]">{t.guide.wideCard.text}</p>
          </div>
          <div class="hidden h-16 w-16 shrink-0 place-items-center rounded-2xl bg-[#073b4c] text-2xl font-black text-white sm:grid">{t.guide.wideCard.badge}</div>
        </div>
      </article>
      {t.guide.cards.map((card) => (
        <article class="card p-7">
          <div class="text-sm font-black uppercase tracking-[.16em] text-[#0b6671]">{card.kicker}</div>
          <h3 class="mt-3 text-2xl font-black text-[#073b4c]">{card.title}</h3>
          <p class="mt-3 leading-7 text-[#657174]">{card.text}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<section class="bg-[#073b4c] py-20 text-white md:py-28">
  <div class="shell grid gap-8 lg:grid-cols-[1.05fr_.95fr] lg:items-center">
    <div class="photo-card relative overflow-hidden rounded-[2rem] bg-[#042a36]">
      <img src="/images/kuah-jetty.webp" alt={t.routes.imageAlt} class="aspect-[4/3] h-full w-full object-cover" width="1280" height="960" loading="lazy" />
      <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/70 to-transparent p-7 pt-24">
        <span class="rounded-full bg-white/15 px-3 py-1 text-xs font-bold backdrop-blur">{t.routes.imageCaption}</span>
      </div>
    </div>
    <div class="lg:pl-8">
      <div class="eyebrow text-[#f1b16f]">{t.routes.eyebrow}</div>
      <h2 class="section-title text-white">{t.routes.title}</h2>
      <div class="mt-10 space-y-8">
        {t.routes.items.map((item) => (
          <div class="route-line grid grid-cols-[24px_1fr] gap-4">
            <div class="mt-1 h-6 w-6 rounded-full border-4 border-[#d88a45] bg-[#073b4c]"></div>
            <div><h3 class="text-xl font-black">{item.title}</h3><p class="mt-2 leading-7 text-white/70">{item.text}</p></div>
          </div>
        ))}
      </div>
      <a href={ferryOperatorUrl} target="_blank" rel="noopener noreferrer" class="mt-10 inline-flex items-center gap-2 rounded-full bg-[#d88a45] px-5 py-3 text-sm font-black transition hover:bg-[#c77736]">{t.routes.cta}</a>
    </div>
  </div>
</section>

<section id="peta" class="shell py-24 md:py-32">
  <div class="grid gap-10 lg:grid-cols-[.72fr_1.28fr] lg:items-end">
    <div>
      <div class="eyebrow text-[#b76531]">{t.map.eyebrow}</div>
      <h2 class="section-title text-[#073b4c]">{t.map.title}</h2>
      <p class="section-copy">{t.map.intro}</p>
      <address class="mt-7 not-italic text-sm font-bold leading-6 text-[#073b4c]">
        <span class="block text-xs font-black uppercase tracking-[.16em] text-[#7a8587]">{t.map.addressLabel}</span>
        {t.map.address}
      </address>
    </div>
    <div class="map-frame overflow-hidden rounded-[2rem] border border-[#073b4c]/10 bg-white shadow-xl shadow-[#073b4c]/10">
      <iframe
        title={t.map.mapTitle}
        src={mapsUrl}
        loading="lazy"
        allowfullscreen
        referrerpolicy="no-referrer-when-downgrade"
      ></iframe>
    </div>
  </div>
</section>

<section id="makan" class="border-y border-[#073b4c]/10 bg-white/65 py-24 md:py-28">
  <div class="shell">
    <div class="eyebrow text-[#b76531]">{t.food.eyebrow}</div>
    <h2 class="section-title text-[#073b4c]">{t.food.title}</h2>
    <p class="section-copy">{t.food.intro}</p>
    <div class="mt-10 grid gap-4 md:grid-cols-2 lg:grid-cols-4">
      {foodPlaces.map((place, index) => (
        <a href={place.url} target="_blank" rel="noopener noreferrer" class="group card flex min-h-64 flex-col p-6 transition hover:-translate-y-1 hover:border-[#d88a45]/50">
          <div class="flex items-center justify-between"><span class="text-xs font-black tracking-[.18em] text-[#b76531]">0{index + 1}</span><span class="text-[#b76531] transition group-hover:translate-x-1">↗</span></div>
          <div class="mt-auto pt-10"><div class="text-xs font-black uppercase tracking-[.15em] text-[#7a8587]">{place.type}</div><h3 class="mt-2 text-xl font-black text-[#073b4c]">{place.name}</h3><p class="mt-3 text-sm leading-6 text-[#657174]">{place.note}</p></div>
        </a>
      ))}
    </div>
  </div>
</section>

<section id="sekitar" class="shell py-24 md:py-32">
  <div class="grid gap-8 lg:grid-cols-[.72fr_1.28fr] lg:items-end">
    <div>
      <div class="eyebrow text-[#b76531]">{t.nearby.eyebrow}</div>
      <h2 class="section-title text-[#073b4c]">{t.nearby.title}</h2>
    </div>
    <p class="section-copy lg:ml-auto">{t.nearby.intro}</p>
  </div>
  <div class="mt-12 grid gap-5 lg:grid-cols-3">
    {t.nearby.places.map((place) => (
      <article class="photo-card group overflow-hidden rounded-[1.8rem] bg-[#073b4c] text-white shadow-xl shadow-[#073b4c]/10">
        <div class="overflow-hidden"><img src={place.image} alt={place.alt} class="aspect-[4/3] w-full object-cover" loading="lazy" width="1280" height="960" /></div>
        <div class="p-7"><div class="text-xs font-black uppercase tracking-[.17em] text-[#f1b16f]">{place.kicker}</div><h3 class="mt-2 text-2xl font-black">{place.name}</h3><p class="mt-3 leading-7 text-white/70">{place.note}</p></div>
      </article>
    ))}
  </div>
  <div class="mt-5 rounded-[1.8rem] border border-[#073b4c]/10 bg-[#073b4c] p-7 text-white md:flex md:items-center md:justify-between md:gap-6">
    <div><div class="text-xs font-black uppercase tracking-[.17em] text-[#f1b16f]">{t.nearby.extra.label}</div><h3 class="mt-2 text-2xl font-black">{t.nearby.extra.title}</h3><p class="mt-2 max-w-2xl text-sm leading-6 text-white/70">{t.nearby.extra.text}</p></div>
    <a href={extraQuery} target="_blank" rel="noopener noreferrer" class="mt-5 inline-flex rounded-full border border-white/25 px-5 py-3 text-sm font-black hover:bg-white/10 md:mt-0">{t.nearby.extra.cta}</a>
  </div>
</section>

<section id="faq" class="bg-[#efe3d0] py-24 md:py-28">
  <div class="shell grid gap-12 lg:grid-cols-[.72fr_1.28fr]">
    <div>
      <div class="eyebrow text-[#b76531]">{t.faq.eyebrow}</div>
      <h2 class="section-title text-[#073b4c]">{t.faq.title}</h2>
    </div>
    <div class="divide-y divide-[#073b4c]/15 border-y border-[#073b4c]/15">
      {t.faq.items.map((item, index) => (
        <details class="faq-item group py-2">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-5 py-5 text-left text-lg font-black text-[#073b4c] marker:hidden">
            <span><span class="mr-3 text-xs tracking-[.16em] text-[#b76531]">0{index + 1}</span>{item.q}</span>
            <svg class="h-5 w-5 shrink-0 transition" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
          </summary>
          <p class="pb-6 pl-0 pr-10 leading-7 text-[#59666b] md:pl-10">{item.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<section class="shell py-20">
  <div class="grid gap-8 rounded-[2rem] border border-[#073b4c]/10 bg-white p-7 md:grid-cols-[1fr_auto] md:items-center md:p-10">
    <div>
      <div class="text-xs font-black uppercase tracking-[.17em] text-[#b76531]">{t.verify.label}</div>
      <h2 class="mt-2 text-2xl font-black text-[#073b4c]">{t.verify.title}</h2>
      <p class="mt-3 max-w-3xl leading-7 text-[#657174]">{t.verify.text}</p>
    </div>
    <a href={ferryOperatorUrl} target="_blank" rel="noopener noreferrer" class="inline-flex w-fit rounded-full bg-[#073b4c] px-5 py-3 text-sm font-black text-white hover:bg-[#0b6671]">{t.verify.cta}</a>
  </div>
</section>
